// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}


// User.id holds the Clerk user ID (e.g. "user_2NNq...").
// Set this from the Clerk userId when creating a User row on first sign-in.
model User {
  id        String   @id
  email     String   @unique
  isPremium Boolean  @default(false)
  createdAt DateTime @default(now())

  subscriptions Subscription[]
  emailLogs     EmailLog[]
  summaries     Summary[]
}

model Channel {
  id                String   @id @default(cuid())
  youtubeChannelId  String   @unique
  uploadsPlaylistId String
  name              String
  handle            String?
  description       String?
  thumbnailUrl      String?
  url               String?
  lastCheckedAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  videos        Video[]
  subscriptions Subscription[]
}

model Subscription {
  id             String   @id @default(cuid())
  userId         String
  channelId      String
  preferredModel String?  // null → Haiku default; validated against approved list on write
  promptPreset   String?  // null → "general"; one of: general | stock_picks | bull_bear | fact_check
  customPrompt   String?  // null → use preset; premium users only; max 2000 chars
  createdAt      DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model Video {
  id              String    @id @default(cuid())
  youtubeVideoId  String    @unique
  channelId       String
  title           String
  description     String?
  thumbnailUrl    String?
  url             String?
  durationSeconds Int?
  publishedAt     DateTime?
  hasCaptions     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  channel    Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  transcript Transcript?
  summaries  Summary[]
  emailLogs  EmailLog[]
}

model Transcript {
  id        String           @id @default(cuid())
  videoId   String           @unique
  content   String
  language  String?
  source    TranscriptSource @default(AUTO)
  fetchedAt DateTime         @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

enum TranscriptSource {
  HUMAN // channel-uploaded caption track (YouTube hasCaptions = true)
  AUTO  // YouTube auto-generated captions fetched via Supadata
}

// Per-user summary — each subscriber gets their own generated output using
// their chosen model and prompt preset/custom prompt.
model Summary {
  id            String   @id @default(cuid())
  videoId       String
  userId        String
  content       String
  model         String?
  promptVersion String?  // e.g. "preset:stock_picks", "custom:v1", "preset:general"
  generatedAt   DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
}

// Tracks per-(user, video) send status so a user is never emailed twice
// about the same video.
model EmailLog {
  id        String      @id @default(cuid())
  userId    String
  videoId   String
  status    EmailStatus @default(PENDING)
  sentAt    DateTime?
  error     String?
  createdAt DateTime    @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}
